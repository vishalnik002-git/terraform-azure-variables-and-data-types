# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with sensitive information
*.tfvars
*.tfvars.json

# Allow example files
!*.tfvars.example

# Override for lock file
!.terraform.lock.hcl

# Ignore OS specific files
.DS_Store
Thumbs.db
